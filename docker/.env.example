# ──────────────────────────────────────────────────────────────────────────────
# Recapito - Environment Variables
# ──────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ──────────────────────────────────────────────────────────────────────────────

# ── Database (PostgreSQL) ────────────────────────────────────────────────────
DATABASE_USERNAME=recapito_prod
DATABASE_PASSWORD=CHANGE_ME_strong_password_here
DATABASE_NAME=recapito_prod
DATABASE_HOST=postgres
DATABASE_PORT=5432

# ── Authentication (JWT) ─────────────────────────────────────────────────────
# Generate a secure random string: openssl rand -hex 64
JWT_SECRET=CHANGE_ME_generate_with_openssl_rand_hex_64
JWT_EXPIRES_IN=7d

# ── Mailgun (Email Sending) ─────────────────────────────────────────────────
# Sign up at https://www.mailgun.com/ and get your API keys
MAILGUN_PRIVATE_API_KEY=your-mailgun-private-api-key
MAILGUN_DOMAIN=mail.yourdomain.com
MAILGUN_BASE_URL=https://api.mailgun.net
MAILGUN_FROM_EMAIL=noreply@yourdomain.com
MAILGUN_FROM_NAME=Your App Name
MAILGUN_WEBHOOK_SIGNING_KEY=your-mailgun-webhook-signing-key

# ── Frontend ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=https://api.yourdomain.com

# ── IMAP Daemon ──────────────────────────────────────────────────────────────
# Poll interval in milliseconds (default: 60 seconds)
IMAP_POLL_INTERVAL_MS=60000
