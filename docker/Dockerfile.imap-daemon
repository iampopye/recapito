# Build stage
FROM node:20-alpine AS builder

RUN npm install -g pnpm

WORKDIR /app

# Copy package.json
COPY apps/imap-daemon/package.json ./

# Install all dependencies
RUN pnpm install

# Copy source files
COPY apps/imap-daemon/src ./src
COPY apps/imap-daemon/tsconfig.json ./

# Build
RUN npx tsc

# Production stage
FROM node:20-alpine AS runner

RUN npm install -g pnpm

WORKDIR /app

# Copy package.json and install prod dependencies
COPY apps/imap-daemon/package.json ./
RUN pnpm install --prod

# Copy built files
COPY --from=builder /app/dist ./dist

CMD ["node", "dist/index.js"]
