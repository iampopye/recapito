# Build stage
FROM node:20-alpine AS builder

RUN npm install -g pnpm

WORKDIR /app

# Copy workspace files
COPY package.json pnpm-workspace.yaml ./
COPY apps/imap-daemon/package.json ./apps/imap-daemon/

# Install dependencies
RUN pnpm install

# Copy source files
COPY apps/imap-daemon ./apps/imap-daemon

# Build
WORKDIR /app/apps/imap-daemon
RUN pnpm build

# Production stage
FROM node:20-alpine AS runner

RUN npm install -g pnpm

WORKDIR /app

# Copy necessary files
COPY --from=builder /app/package.json /app/pnpm-workspace.yaml ./
COPY --from=builder /app/apps/imap-daemon/package.json ./apps/imap-daemon/
COPY --from=builder /app/apps/imap-daemon/dist ./apps/imap-daemon/dist

# Install production dependencies only
RUN pnpm install --prod

WORKDIR /app/apps/imap-daemon

CMD ["node", "dist/index.js"]
