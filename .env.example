# ===========================================
# Recapito - local development configuration
# ===========================================
#
#   cp .env.example .env
#
# Then fill in the two REQUIRED secrets below. The backend validates this file
# at boot and refuses to start if a required value is missing or is still a
# placeholder -- it will name the exact variable.

# -------------------------------------------
# REQUIRED SECRETS - generate your own
# -------------------------------------------

# Signs session tokens. Anyone who knows this can mint a token for any account.
#   openssl rand -hex 32
JWT_SECRET=

# Encrypts IMAP passwords, SMTP passwords and provider API keys at rest
# (AES-256-GCM). Must be exactly 64 hex characters (32 bytes).
#   openssl rand -hex 32
#
# WARNING: if you lose this key, every stored mailbox credential becomes
# permanently unreadable and each mailbox has to be reconnected by hand.
# Back it up somewhere separate from your database backups.
ENCRYPTION_KEY=

# -------------------------------------------
# Database
# -------------------------------------------
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USERNAME=recapito
# No default is baked into the code -- a shipped default password is a
# credential every deployment shares. Set a real one even locally.
DATABASE_PASSWORD=
DATABASE_NAME=recapito

# Run pending migrations on boot. Leave true unless you run them yourself as a
# separate deploy step.
DB_MIGRATIONS_RUN=true

# Let TypeORM alter the schema to match the entities. Leave this OFF.
# It can drop columns and their data on startup. Migrations are the only
# supported way to change the schema.
DB_SYNCHRONIZE=false

# -------------------------------------------
# Authentication
# -------------------------------------------
JWT_EXPIRES_IN=7d

# A self-hosted instance is reachable by anyone who finds the URL, so public
# sign-up is closed by default. The FIRST account created is always allowed and
# becomes the administrator; set this to true afterwards to reopen sign-up.
ALLOW_REGISTRATION=false

# -------------------------------------------
# Backend
# -------------------------------------------
BACKEND_PORT=3001
BACKEND_URL=http://localhost:3001

# Comma-separated origins allowed to call the API with credentials. Must be the
# exact URL(s) your frontend is served from. Defaults to http://localhost:3000
# when unset -- fine locally, wrong in production.
CORS_ORIGINS=http://localhost:3000

# -------------------------------------------
# Frontend
# -------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:3001

# -------------------------------------------
# Attachments
# -------------------------------------------
# Where attachment files are written. Under Docker this must be a mounted
# volume, or attachments disappear when the container is recreated.
ATTACHMENTS_PATH=./data/attachments

# Largest single attachment to store, in bytes. Default 25 MB.
ATTACHMENT_MAX_BYTES=26214400

# -------------------------------------------
# Outbound email (optional)
# -------------------------------------------
# Seed values only. The running app reads its Mailgun configuration from the
# database, set through the Settings screen -- not from these variables.
MAILGUN_PRIVATE_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_BASE_URL=https://api.mailgun.net
MAILGUN_FROM_EMAIL=
MAILGUN_FROM_NAME=

# Required to accept Mailgun delivery/bounce webhooks. That endpoint is public
# by design, so this signature is its only authentication -- with no key set,
# webhook events are rejected outright rather than trusted.
MAILGUN_WEBHOOK_SIGNING_KEY=

# -------------------------------------------
# Misc
# -------------------------------------------
NODE_ENV=development

# Note: IMAP_POLL_INTERVAL_MS used to appear here. It was never read by any
# code -- the daemon uses IMAP IDLE (persistent push connections) for INBOX and
# a fixed 5-minute sweep for other folders. Removed to stop it looking like a
# working knob.
