# ===========================================
# Rio Mailer Environment Configuration
# ===========================================

# Database
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USERNAME=rio
DATABASE_PASSWORD=rio_secret
DATABASE_NAME=rio_mailer

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# Mailgun Configuration
MAILGUN_PRIVATE_API_KEY=key-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
MAILGUN_DOMAIN=mail.yourdomain.com
MAILGUN_BASE_URL=https://api.eu.mailgun.net
MAILGUN_FROM_EMAIL=sales@yourdomain.com
MAILGUN_FROM_NAME=Sales Team

# Mailgun Webhook Signing Key (for verification)
MAILGUN_WEBHOOK_SIGNING_KEY=your-webhook-signing-key

# Backend
BACKEND_PORT=3001
BACKEND_URL=http://localhost:3001

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:3001

# IMAP Daemon
IMAP_POLL_INTERVAL_MS=60000
