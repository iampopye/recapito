# ===========================================
# Rio Mailer - Production Environment
# ===========================================
# IMPORTANT: Copy this to .env and fill in all values
# Never commit the .env file to version control!

# ============ REQUIRED ============

# Database (use strong password!)
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_USERNAME=rio_prod
DATABASE_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE
DATABASE_NAME=rio_mailer_prod

# JWT (generate a secure random string: openssl rand -hex 64)
JWT_SECRET=CHANGE_ME_GENERATE_SECURE_SECRET
JWT_EXPIRES_IN=7d

# Mailgun (get these from your Mailgun dashboard)
MAILGUN_PRIVATE_API_KEY=key-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
MAILGUN_DOMAIN=mail.yourdomain.com
MAILGUN_BASE_URL=https://api.eu.mailgun.net
MAILGUN_FROM_EMAIL=sales@yourdomain.com
MAILGUN_FROM_NAME=Sales Team
MAILGUN_WEBHOOK_SIGNING_KEY=your-webhook-signing-key

# URLs
NEXT_PUBLIC_API_URL=https://api.yourdomain.com
BACKEND_URL=https://api.yourdomain.com

# ============ OPTIONAL ============

# Backend
BACKEND_PORT=3001
NODE_ENV=production

# IMAP
IMAP_POLL_INTERVAL_MS=60000

# Docker
VERSION=latest
DOCKER_REGISTRY=ghcr.io/yourusername

# SSL Domain (for Nginx)
SSL_DOMAIN=yourdomain.com
